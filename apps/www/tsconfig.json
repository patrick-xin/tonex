{
  "extends": "@tonex/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      // Internal packages resolve to SOURCE, never built dist — the source-mode
      // workspace mapping keeps grep / go-to-def / stack traces on src (ADR-0011).
      "@/*": ["./src/*"],
      "collections/*": ["./.source/*"],
      "@tonex/core": ["../../packages/core/src/index.ts"],
      "@tonex/core-react": ["../../packages/core-react/src/index.ts"],
      "@tonex/mcu": ["../../packages/mcu/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
