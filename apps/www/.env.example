# Base URL for absolute links in transactional emails (welcome, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API secret (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx

# Sending domain. Use `resend.dev` for early testing (delivers only to your
# Resend account email); swap to a verified domain post-launch.
EMAIL_DOMAIN=resend.dev
