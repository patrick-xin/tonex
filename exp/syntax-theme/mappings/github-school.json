{
  "label": "github-school",
  "description": "GitHub primer school: keywords run red (error family), strings take the palette's watery cool hue, functions/types share the entity purple, tags green, variables stay at default foreground. Structurally opposite to editor-school: brand hue lands on strings/tags instead of functions/keywords.",
  "slots": {
    "function": "hue(270)",
    "keyword": "error",
    "attribute": "@string",
    "type": "@function",
    "string": "hue(205)",
    "escape": "@string",
    "number": "orange",
    "parameter": "@number",
    "tag": "hue(130)",
    "property": "@punctuation",
    "operator": "on-surface",
    "punctuation": "on-surface-variant",
    "comment": "outline",
    "invalid": "error",
    "markup.heading": "@function",
    "markup.raw": "@string",
    "markup.list": "@number",
    "markup.link": "@string",
    "markup.quote": "@comment",
    "markup.inserted": "@tag",
    "markup.deleted": "@invalid",
    "markup.changed": "@number",
    "css.class-selector": "@tag",
    "css.property-value": "@string"
  },
  "semantic": {
    "function": "@function",
    "parameter": "@parameter",
    "property": "@punctuation",
    "variable.defaultLibrary": "@tag",
    "namespace": "@function"
  },
  "chrome": {
    "editor.background": "surface-container-low",
    "editor.foreground": "on-surface",
    "editor.selectionBackground": "primary@30",
    "editor.inactiveSelectionBackground": "primary@15",
    "editor.lineHighlightBackground": "surface-container",
    "editorLineNumber.foreground": "outline",
    "editorLineNumber.activeForeground": "on-surface-variant",
    "editorCursor.foreground": "primary",
    "editorIndentGuide.background1": "outline-variant",
    "editorIndentGuide.activeBackground1": "outline",
    "editorGutter.background": "surface-container-low",
    "editorGutter.addedBackground": "{tag}@40",
    "editorGutter.modifiedBackground": "{number}@40",
    "editorGutter.deletedBackground": "{error}@40",
    "editorBracketMatch.border": "secondary",
    "editorBracketMatch.background": "surface-container",
    "editor.findMatchBackground": "{number}@30",
    "editor.findMatchHighlightBackground": "primary@15",
    "editor.wordHighlightBackground": "surface-container-high",
    "diffEditor.insertedTextBackground": "{tag}@15",
    "diffEditor.removedTextBackground": "{error}@15",
    "sideBar.background": "surface",
    "sideBar.foreground": "on-surface",
    "sideBarSectionHeader.background": "surface",
    "activityBar.background": "surface",
    "activityBar.foreground": "on-surface-variant",
    "activityBarBadge.background": "primary",
    "activityBarBadge.foreground": "on-primary",
    "editorGroupHeader.tabsBackground": "surface",
    "tab.activeBackground": "surface-container-low",
    "tab.inactiveBackground": "surface-container",
    "tab.activeForeground": "on-surface",
    "tab.inactiveForeground": "on-surface-variant",
    "tab.activeBorderTop": "primary",
    "statusBar.background": "surface-container",
    "statusBar.foreground": "on-surface-variant",
    "statusBar.debuggingBackground": "orange-container",
    "statusBar.debuggingForeground": "on-orange-container",
    "titleBar.activeBackground": "surface",
    "editorWidget.background": "surface-container-high",
    "editorWidget.border": "outline-variant",
    "editorSuggestWidget.background": "surface-container",
    "editorSuggestWidget.selectedBackground": "secondary-container",
    "input.background": "surface-container-high",
    "input.border": "outline-variant",
    "input.foreground": "on-surface",
    "dropdown.background": "surface-container-high",
    "focusBorder": "primary",
    "list.hoverBackground": "surface-container",
    "list.activeSelectionBackground": "secondary-container",
    "list.activeSelectionForeground": "on-surface",
    "list.inactiveSelectionBackground": "surface-container",
    "badge.background": "secondary-container",
    "scrollbarSlider.background": "outline-variant@40",
    "scrollbarSlider.hoverBackground": "outline-variant@60",
    "scrollbarSlider.activeBackground": "outline@60",
    "terminal.ansiBlack": "surface",
    "terminal.ansiBlue": "{string}",
    "terminal.ansiCyan": "{tag}",
    "terminal.ansiGreen": "{tag}",
    "terminal.ansiMagenta": "{function}",
    "terminal.ansiRed": "{error}",
    "terminal.ansiYellow": "{number}",
    "terminal.ansiWhite": "on-surface",
    "terminal.ansiBrightBlack": "outline",
    "terminal.ansiBrightBlue": "{string}",
    "terminal.ansiBrightCyan": "{tag}",
    "terminal.ansiBrightGreen": "{tag}",
    "terminal.ansiBrightMagenta": "{function}",
    "terminal.ansiBrightRed": "{error}",
    "terminal.ansiBrightYellow": "{number}",
    "terminal.ansiBrightWhite": "on-surface",
    "gitDecoration.addedResourceForeground": "{tag}",
    "gitDecoration.modifiedResourceForeground": "{number}",
    "gitDecoration.deletedResourceForeground": "{error}",
    "gitDecoration.untrackedResourceForeground": "{tag}",
    "gitDecoration.conflictingResourceForeground": "{function}"
  },
  "expectSubAA": ["comment"]
}
